{
  "name": "gkeep-parser",
  "version": "0.3.2",
  "description": "Convert Google Keep Takeout exports (HTML) into structured JSON data.",
  "type": "module",
  "bin": {
    "gkeep-parser": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test",
    "lint": "tsc --noEmit",
    "test": "node --import=tsx --test --test-concurrency=1 test/*.test.mjs"
  },
  "keywords": [
    "google-keep",
    "takeout",
    "parser",
    "converter",
    "json",
    "notes",
    "migration"
  ],
  "author": {
    "name": "Ghazi Khan",
    "url": "https://mgks.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgks/gkeep-parser.git"
  },
  "bugs": {
    "url": "https://github.com/mgks/gkeep-parser/issues"
  },
  "homepage": "https://github.com/mgks/gkeep-parser#readme",
  "funding": "https://github.com/sponsors/mgks",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^11.1.0",
    "dayjs": "^1.11.20"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
